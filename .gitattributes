# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Explicit binary files (do not normalize or modify line endings)
*.xlsx binary
*.xls binary
*.docx binary
*.doc binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary
